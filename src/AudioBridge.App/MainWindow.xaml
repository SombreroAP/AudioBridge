<Window x:Class="AudioBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioBridge" Height="720" Width="560"
        Background="{StaticResource Surface}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="AudioBridge" FontSize="22" FontWeight="Bold" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="Send game audio to your streaming PC, and your microphone back to your gaming PC." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Step 1: role -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="1 · Which PC is this?" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RoleToggle}" GroupName="Role"
                                         IsChecked="{Binding IsGamingPc, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Gaming PC" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs the games" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource RoleToggle}" GroupName="Role"
                                         IsChecked="{Binding IsStreamingPc, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Streaming PC" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Has your headphones and mic" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Run AudioBridge on both PCs and set each one to a different option." />
                    </StackPanel>
                </Border>

                <!-- Step 2: the other PC -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="2 · The other PC" />
                        <ComboBox x:Name="PeerCombo" ItemsSource="{Binding Peers}"
                                  SelectedItem="{Binding SelectedPeer, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Not showing up? Windows Firewall blocks the search by default. Click below on BOTH PCs, then wait a few seconds." />
                        <Button Style="{StaticResource LinkButton}" Content="Allow AudioBridge through Windows Firewall"
                                Command="{Binding AllowFirewallCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Still nothing? Type the other PC's IP address here:" />
                        <TextBox Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsIdle}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                            <Run Text="This PC is at " /><Run Text="{Binding LocalAddresses, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Step 3: devices -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="3 · Audio devices" />

                        <TextBlock Text="{Binding DeviceSectionLabel}" />
                        <ComboBox ItemsSource="{Binding RenderDevices}" DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedRenderDevice, Mode=TwoWay}"
                                  IsEnabled="{Binding IsIdle}" />

                        <StackPanel Visibility="{Binding ShowCaptureDevice, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,14,0,0">
                            <TextBlock Text="Microphone to send to the gaming PC" />
                            <ComboBox ItemsSource="{Binding CaptureDevices}" DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedCaptureDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding IsIdle}" />
                        </StackPanel>

                        <Button Style="{StaticResource LinkButton}" Content="Refresh device list"
                                Command="{Binding RefreshDevicesCommand}" Margin="0,12,0,0"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Only the gaming PC needs this, so it sits outside the numbered steps. -->
                <Border Style="{StaticResource CardPanel}"
                        Visibility="{Binding NeedsCable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Virtual microphone" />
                        <TextBlock Text="{Binding CableStatus}" />

                        <StackPanel Visibility="{Binding CableMissing, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="To make your streaming PC's microphone show up in games on this PC, Windows needs a virtual audio device. AudioBridge uses VB-CABLE for this." />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="{Binding CableAttribution}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource LinkButton}" Content="Open vb-cable.com"
                                        Click="OpenCableSite" Margin="0,0,16,0" />
                                <Button Style="{StaticResource LinkButton}" Content="I've installed it — check again"
                                        Command="{Binding RecheckCableCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Foreground="#FFB84D"
                                       Text="Restart Windows after installing VB-CABLE, then reopen AudioBridge." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardPanel}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="#7A3B3B" Background="#241A1C">
                    <TextBlock Text="{Binding Error}" Foreground="#FF9A9A" />
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}" Content="Start"
                        Command="{Binding StartCommand}"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}" Content="Stop"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
